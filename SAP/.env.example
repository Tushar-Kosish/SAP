# SmartEvac Environment Configuration

# LLM Provider Options: openai, gemini, or mock (default: mock if keys missing)
LLM_PROVIDER=openai

# OpenAI API Key (Required for CrewAI with OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o

# Google Gemini API Key (Alternative LLM Brain)
GEMINI_API_KEY=your_gemini_api_key_here

# SAP BTP / SAP TM Integration Parameters
SAP_BTP_TM_URL=https://sandbox.api.sap.com/saptm/v1
SAP_BTP_CLIENT_ID=mock_sap_btp_client_id
SAP_BTP_CLIENT_SECRET=mock_sap_btp_client_secret

# Database Configuration (Firebase Firestore or local JSON fallback)
FIREBASE_CREDENTIALS_FILE=firebase_key.json
USE_LOCAL_DB_FALLBACK=true
